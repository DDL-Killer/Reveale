###############################################################
# Bochs 配置文件 - 2026.04.27 精准修正版
###############################################################

# 1. 内存设置
megs: 32

# 2. 显示库设置
display_library: sdl2

# 3. 修正后的 BIOS 路径 (使用你 ls 确认过的文件名)
romimage: file="/usr/local/share/bochs/BIOS-bochs-latest"
vgaromimage: file="/usr/local/share/bochs/VGABIOS-lgpl-latest"

# 4. 键盘映射
keyboard: keymap="/usr/local/share/bochs/keymaps/sdl2-pc-us.map"

# 5. 启动顺序
boot: disk

# 6. 硬盘设置
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, path="master.img", mode=flat, cylinders=121, heads=16, spt=63

# 7. 日志设置
log: bochs.out

# 8. 其他设置
mouse: enabled=0
cpu: count=1, ips=4000000